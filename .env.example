# Database
DATABASE_URL=mongodb://localhost:27017/your_database_name

# JWT
JWT_SECRET=your_jwt_secret_key

# Email Configuration
# Gmail authorizes a "Send mail as" alias through the SMTP account that owns it.
# The aliases below are on dundogames.com; change every address together if the
# canonical mail domain changes. Use Google app passwords or OAuth credentials.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
AMIR_MAIL_USER=amir@dundogames.com
AMIR_MAIL_PASS=your-amir-app-password
OPERATIONS_MAIL_USER=operations@dundogames.com
OPERATIONS_MAIL_PASS=your-operations-app-password
INFO_MAIL_ADDRESS=info@dundogames.com
NO_REPLY_MAIL_ADDRESS=no-reply@dundogames.com
SUBSCRIBE_MAIL_ADDRESS=subscribe@dundogames.com
SUPPORT_MAIL_ADDRESS=support@dundogames.com
ORDERS_MAIL_ADDRESS=orders@dundogames.com
# Explicit reply destinations; a no-reply message is routed to support.
INFO_REPLY_TO=info@dundogames.com
NO_REPLY_REPLY_TO=support@dundogames.com
SUBSCRIBE_REPLY_TO=support@dundogames.com
SUPPORT_REPLY_TO=support@dundogames.com
ORDERS_REPLY_TO=support@dundogames.com
# Internal operational notifications.
ADMIN_NOTIFICATION_RECIPIENT=info@dundogames.com
SUPPORT_NOTIFICATION_RECIPIENT=support@dundogames.com
ORDER_NOTIFICATION_RECIPIENT=orders@dundogames.com
SUBSCRIPTION_NOTIFICATION_RECIPIENT=subscribe@dundogames.com
LOGO_URL=https://doundogames.com/logo-white.png

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Currency
CAD_EXCHANGE_RATE=1.44
