# Database
DATABASE_URL=mongodb://localhost:27017/your_database_name

# JWT
JWT_SECRET=your_jwt_secret_key

# Email Configuration
# Each mailbox must be a verified SMTP sender. Do not use a Gmail fallback,
# otherwise providers can rewrite the visible From address.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=info@doundogames.com
MAIL_PASS=your-mail-password
NO_REPLY_MAIL_USER=no-reply@doundogames.com
NO_REPLY_MAIL_PASS=your-noreply-password
SUBSCRIBE_MAIL_USER=subscribe@doundogames.com
SUBSCRIBE_MAIL_PASS=your-subscribe-password
INFO_MAIL_USER=info@doundogames.com
INFO_MAIL_PASS=your-info-password
SUPPORT_MAIL_USER=support@doundogames.com
SUPPORT_MAIL_PASS=your-support-password
ORDERS_MAIL_USER=orders@doundogames.com
ORDERS_MAIL_PASS=your-orders-password
LOGO_URL=https://doundogames.com/logo-white.png

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Currency
CAD_EXCHANGE_RATE=1.44
