# Database
DATABASE_URL=mongodb://localhost:27017/your_database_name

# JWT
JWT_SECRET=your_jwt_secret_key

# Email Configuration (aligned with ConfigService & EmailService)
ADMIN_EMAIL=admin@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
INFO_MAIL_USER=info@example.com
INFO_MAIL_PASS=your-info-password
SUBSCRIBE_MAIL_USER=subscribe@example.com
SUBSCRIBE_MAIL_PASS=your-subscribe-password
ORDERS_MAIL_USER=orders@example.com
ORDERS_MAIL_PASS=your-orders-password

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Currency
CAD_EXCHANGE_RATE=1.44
